{
  "info": {
    "_postman_id": "f7cc96a7-6e8c-4c79-a3b6-6b69e6e9a1f2",
    "name": "Crea Tech Hub - Catálogo público de espaços",
    "description": "Casos manuais e automatizados do catálogo público de espaços. A API deve estar disponível em {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "spaceId",
      "value": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "item": [
    {
      "name": "Listar catálogo padrão",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/spaces",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "spaces"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Retorna página do catálogo', function () {",
              "    pm.expect(body).to.have.property('items').that.is.an('array');",
              "    pm.expect(body).to.have.property('page');",
              "    pm.expect(body).to.have.property('size');",
              "    pm.expect(body).to.have.property('totalElements');",
              "    pm.expect(body).to.have.property('totalPages');",
              "});",
              "pm.test('Não expõe campos administrativos', function () {",
              "    body.items.forEach(function (space) {",
              "        pm.expect(space).to.not.have.property('active');",
              "        pm.expect(space).to.not.have.property('createdAt');",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Paginar catálogo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/spaces?page=0&size=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "spaces"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Respeita a página solicitada', function () {",
              "    pm.expect(body.page).to.eql(0);",
              "    pm.expect(body.size).to.eql(1);",
              "    pm.expect(body.items.length).to.be.at.most(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Rejeitar página negativa",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/spaces?page=-1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 400', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Rejeitar tamanho zero",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/spaces?size=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 400', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Rejeitar tamanho acima do limite",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/spaces?size=101"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 400', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Rejeitar página não numérica",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/spaces?page=abc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 400', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Bloquear acesso a espaço administrativo sem autenticação",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/admin/spaces/{{spaceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Bloquear escrita no catálogo público",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Espaço não autorizado\",\"type\":\"ROOM\",\"capacity\":1}"
        },
        "url": "{{baseUrl}}/api/v1/spaces"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
