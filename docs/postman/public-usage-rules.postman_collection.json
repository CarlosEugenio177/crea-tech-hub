{
  "info": {
    "_postman_id": "5dc1e4ea-0eb3-4e2a-a89f-2d7a4ea1f7c6",
    "name": "Crea Tech Hub - Regras públicas de uso",
    "description": "Casos manuais e automatizados das regras gerais públicas do Hub. A API deve estar disponível em {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Consultar regras gerais sem login",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/hub/usage-rules",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "hub",
            "usage-rules"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retorna 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna JSON', function () {",
              "    pm.response.to.have.header('Content-Type');",
              "    pm.response.to.be.withBody;",
              "    pm.response.to.be.json;",
              "});",
              "const body = pm.response.json();",
              "pm.test('Exige aceite das regras gerais', function () {",
              "    pm.expect(body.acceptanceRequired).to.eql(true);",
              "});",
              "pm.test('Retorna uma lista de regras gerais', function () {",
              "    pm.expect(body.generalRules).to.be.an('array');",
              "    pm.expect(body.generalRules).to.have.lengthOf(4);",
              "    pm.expect(body.generalRules[0]).to.eql(",
              "        'Todas as solicitações passam por análise manual antes da confirmação.'",
              "    );",
              "});",
              "pm.test('Não expõe dados pessoais ou administrativos', function () {",
              "    pm.expect(body).to.not.have.property('email');",
              "    pm.expect(body).to.not.have.property('phone');",
              "    pm.expect(body).to.not.have.property('password');",
              "    pm.expect(body).to.not.have.property('permissions');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
